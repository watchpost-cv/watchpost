[Unit]
Description=Watchpost monitoring service
After=network-online.target

[Service]
User=watchpost
Group=watchpost
ExecStart=/usr/local/bin/watchpost --listen 127.0.0.1:8080 --data-dir /var/lib/watchpost
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/watchpost

[Install]
WantedBy=multi-user.target
